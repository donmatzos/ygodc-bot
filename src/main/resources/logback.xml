<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %X{actor}: who triggered the database work, set by DatabaseReplies (empty elsewhere) -->
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%X{actor}%n</pattern>
        </encoder>
    </appender>

    <logger name="net.dv8tion.jda" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
